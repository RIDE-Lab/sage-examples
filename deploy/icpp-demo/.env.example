# Startup scripts copy this file to .env only when .env does not exist.
# Defaults run the real model-independent demos without external services.
LOCAL_DEMO_PORT=18400
SAGE_LLM_BASE_URL=
SAGE_LLM_MODEL=
SAGE_OPENAI_API_KEY=EMPTY
SAGE_EMBEDDING_BASE_URL=
SAGE_RERANKER_BASE_URL=

# Optional lab configuration, only when reachable from your Docker container:
# SAGE_LLM_BASE_URL=http://11.11.11.31:8000/v1
# SAGE_LLM_MODEL=Qwen2.5-3B-Instruct
# SAGE_RERANKER_BASE_URL=http://11.11.11.31:8001
# Port 8001 serves BAAI/bge-reranker-v2-m3, NOT an embedding model.
# No embedding endpoint has been verified. Leave it empty until configured.
# Model settings apply to compose.hub.yaml. compose.local.yaml always disables them.
